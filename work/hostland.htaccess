# Canonical origin for plancod.ru. Keep certificate validation untouched.
RewriteEngine On
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Preserve external links and campaign parameters of the old smart-home page.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteRule ^smart-home(?:\.html|/)?$ https://plancod.ru/smart-systems/home/ [R=308,L,NE]
RewriteRule ^smart-home(?:\.html|/)?$ https://plancod.ru/smart-systems/home/ [R=301,L,NE]

# Legacy application routes must reach the published HTML pages, including
# /design/ which is also the parent directory of the individual services.
# Match only these top-level routes; preserve every nested service/project URL.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteRule ^(design|projects|products|about|privacy)/?$ https://plancod.ru/$1.html [R=308,L,NE]
RewriteRule ^(design|projects|products|about|privacy)/?$ https://plancod.ru/$1.html [R=301,L,NE]

# Redirect only explicit requests, never Apache's internal DirectoryIndex lookup.
# No replacement query string: preserve campaign parameters and browser fragments.
RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])"
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteRule ^index\.html$ https://plancod.ru/ [R=308,L,NE]
RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])"
RewriteRule ^index\.html$ https://plancod.ru/ [R=301,L,NE]

# Hostland can terminate TLS at its front proxy; check both TLS signals.
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ - [E=PLANKOD_CANONICAL_REDIRECT:1]
RewriteCond %{HTTP_HOST} ^www\.plancod\.ru(?::[0-9]+)?$ [NC]
RewriteRule ^ - [E=PLANKOD_CANONICAL_REDIRECT:1]

# Preserve method and body if a form is submitted from a noncanonical origin.
RewriteCond %{ENV:PLANKOD_CANONICAL_REDIRECT} =1
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteRule ^ https://plancod.ru%{REQUEST_URI} [R=308,L,NE]
RewriteCond %{ENV:PLANKOD_CANONICAL_REDIRECT} =1
RewriteRule ^ https://plancod.ru%{REQUEST_URI} [R=301,L,NE]
